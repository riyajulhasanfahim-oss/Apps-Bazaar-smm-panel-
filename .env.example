# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://your-panel-domain.example.com"

# PORT: Server HTTP listen port (default: 3000)
PORT="3000"

# NODE_ENV: Set to "production" when serving the compiled Vite dist/ bundle via server.ts
NODE_ENV="production"

# Optional fallback Firebase project target if not supplied via firebase-applet-config.json
# (Buyers can also bind their Firebase Project directly from Admin Panel -> White-Label & Setup)
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID="(default)"

# ------------------------------------------------------------------------------
# RJ WORLD BD Own API Gateway (Master Provider Host Only)
# ------------------------------------------------------------------------------
# Required on the Master Gateway host so unauthenticated external reseller calls
# to POST /api/v2 can verify hashed keys and run atomic Firestore transactions:
# Provide either FIREBASE_SERVICE_ACCOUNT_JSON (single-line JSON string) OR GOOGLE_APPLICATION_CREDENTIALS (path).
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Optional HMAC pepper used when hashing/verifying API keys (leave empty for standard SHA-256)
GATEWAY_KEY_PEPPER=""

# ------------------------------------------------------------------------------
# Sold Buyer Website API Lock Mode (Buyer Deployment Only)
# ------------------------------------------------------------------------------
# Set RJW_GATEWAY_LOCKED="true" on sold buyer websites to lock all order dispatches,
# status syncs, and service imports strictly to the RJ WORLD BD Official API.
RJW_GATEWAY_LOCKED="false"
RJW_GATEWAY_BASE_URL=""
RJW_LOCKED_API_KEY=""
RJW_INSTALLATION_ID=""
RJW_API_CUSTOMER_ID=""


